			)
			(justify left)
		)
		(uuid "34e1e28a-e86b-42e0-98cc-d75bffdc4506")
	)
	(text "t_{MAXCHG} = R _{TMR} * 10 * K_{TMR}\nK_{TMR} =  48 s*kOhms\n  => t_{MAXCHG} = ${/62ffec33-ae93-49a8-bfe6-566578dd8e82/88a6fbe6-41b3-454b-9d65-28a89e2e6ca4/1fef2d8c-7095-4b02-b63c-4dbb8f1664e8:Value} * 48 s*kOhms * 10 = 6.2 hours"
		(exclude_from_sim no)
		(at 80.01 153.162 0)
		(effects
