	(text "I_{TERM} = 0.030 * R_{ITERM}/R_{ISET}\nR_{ISET} =  ${/62ffec33-ae93-49a8-bfe6-566578dd8e82/88a6fbe6-41b3-454b-9d65-28a89e2e6ca4/6926b58b-33de-422d-974b-2646295e1edd:VALUE}\n  => I_{TERM} = 0.030 * ${R43:Value}/${/62ffec33-ae93-49a8-bfe6-566578dd8e82/88a6fbe6-41b3-454b-9d65-28a89e2e6ca4/6926b58b-33de-422d-974b-2646295e1edd:VALUE} = 30 mA"
